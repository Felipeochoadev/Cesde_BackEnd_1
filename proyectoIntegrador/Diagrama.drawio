<mxfile host="Electron">
  <diagram id="diagrama-poo-solid-cinemax" name="Diagrama Clases POO y SOLID - CineMax CESDE">
    <mxGraphModel dx="916" dy="448" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_banner" parent="1" style="swimlane;collapsible=0;startSize=0;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;rounded=1;shadow=1;" value="CINEMAX CESDE - DIAGRAMA DE CLASES BACKEND POO Y PRINCIPIOS S.O.L.I.D." vertex="1">
          <mxGeometry height="60" width="2220" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="title_sub" parent="title_banner" style="text;html=1;align=center;verticalAlign=middle;fontColor=#94a3b8;fontSize=12;fontStyle=2;" value="Arquitectura de Dominio Orientada a Objetos | Integración: Base de Datos CineMaxCesde + Interfaz HTML + Matriz de Reglas de Negocio" vertex="1">
          <mxGeometry height="20" width="2200" x="10" y="32" as="geometry" />
        </mxCell>
        <mxCell id="solid_box_s" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=11;align=left;spacing=8;collapsible=0;" value="&lt;b&gt;[S] Single Responsibility Principle (SRP)&lt;/b&gt;&lt;br/&gt;• Entidades (Pelicula, Cliente, Sala) solo gestionan su estado interno.&lt;br/&gt;• Validaciones de negocio delegadas a &lt;i&gt;ValidadorReserva&lt;/i&gt;.&lt;br/&gt;• Lógica de descuentos delegada a estrategias &lt;i&gt;IDescuentoStrategy&lt;/i&gt;." vertex="1">
          <mxGeometry height="85" width="410" x="40" y="105" as="geometry" />
        </mxCell>
        <mxCell id="solid_box_o" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;fontColor=#14532d;fontSize=11;align=left;spacing=8;collapsible=0;" value="&lt;b&gt;[O] Open / Closed Principle (OCP)&lt;/b&gt;&lt;br/&gt;• Abierto a extensión, cerrado a modificación.&lt;br/&gt;• Nuevos descuentos (ej. 2x1, estudiante) se añaden creando clases que implementen &lt;i&gt;IDescuentoStrategy&lt;/i&gt;.&lt;br/&gt;• Nuevos métodos de pago implementan &lt;i&gt;MetodoPago&lt;/i&gt; / &lt;i&gt;IPagable&lt;/i&gt;." vertex="1">
          <mxGeometry height="85" width="410" x="480" y="105" as="geometry" />
        </mxCell>
        <mxCell id="solid_box_l" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#eab308;fontColor=#713f12;fontSize=11;align=left;spacing=8;collapsible=0;" value="&lt;b&gt;[L] Liskov Substitution Principle (LSP)&lt;/b&gt;&lt;br/&gt;• Subclases &lt;i&gt;Cliente&lt;/i&gt; y &lt;i&gt;Empleado&lt;/i&gt; pueden sustituir a la clase base &lt;i&gt;Persona&lt;/i&gt;.&lt;br/&gt;• Cualquier método de pago (&lt;i&gt;PagoTarjeta&lt;/i&gt;, &lt;i&gt;PagoEfectivo&lt;/i&gt;, &lt;i&gt;PagoDigital&lt;/i&gt;) es completamente intercambiable en &lt;i&gt;Factura&lt;/i&gt;." vertex="1">
          <mxGeometry height="85" width="410" x="920" y="105" as="geometry" />
        </mxCell>
        <mxCell id="solid_box_i" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;fontColor=#581c87;fontSize=11;align=left;spacing=8;collapsible=0;" value="&lt;b&gt;[I] Interface Segregation Principle (ISP)&lt;/b&gt;&lt;br/&gt;• Interfaces segregadas y de propósito único:&lt;br/&gt;  - &lt;i&gt;ICalculable&lt;/i&gt;: Para objetos con costo monetario.&lt;br/&gt;  - &lt;i&gt;IValidador&amp;lt;T&amp;gt;&lt;/i&gt;: Para reglas de negocio.&lt;br/&gt;  - &lt;i&gt;IPagable&lt;/i&gt;: Para cobro y detalle de pago.&lt;br/&gt;  - &lt;i&gt;IDescuentoStrategy&lt;/i&gt;: Para descuentos." vertex="1">
          <mxGeometry height="85" width="410" x="1360" y="105" as="geometry" />
        </mxCell>
        <mxCell id="solid_box_d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#f43f5e;fontColor=#881337;fontSize=11;align=left;spacing=8;collapsible=0;" value="&lt;b&gt;[D] Dependency Inversion Principle (DIP)&lt;/b&gt;&lt;br/&gt;• Módulos de alto nivel (&lt;i&gt;Reserva&lt;/i&gt;, &lt;i&gt;Factura&lt;/i&gt;) dependen de abstracciones (&lt;i&gt;IDescuentoStrategy&lt;/i&gt;, &lt;i&gt;IValidador&lt;/i&gt;, &lt;i&gt;MetodoPago&lt;/i&gt;), nunca de clases concretas directamente acopladas." vertex="1">
          <mxGeometry height="85" width="460" x="1800" y="105" as="geometry" />
        </mxCell>
        <mxCell id="pkg_personas" parent="1" style="swimlane;collapsible=0;startSize=25;fillColor=#f8fafc;strokeColor=#94a3b8;fontStyle=1;fontSize=12;rounded=1;" value="Paquete: app.domain (Actores y Usuarios)" vertex="1">
          <mxGeometry height="480" width="390" x="40" y="210" as="geometry" />
