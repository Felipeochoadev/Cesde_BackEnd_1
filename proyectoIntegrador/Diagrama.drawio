        <mxCell id="class_persona" parent="pkg_personas" style="swimlane;collapsible=0;fontStyle=0;align=left;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;fillColor=#fff2cc;strokeColor=#d6b656;html=1;" value="&lt;b&gt;&amp;lt;&amp;lt;abstract&amp;gt;&amp;gt;&lt;br/&gt;Persona&lt;/b&gt;&lt;hr/&gt;- id: int&lt;br/&gt;- nombre: String&lt;br/&gt;- correo: String&lt;br/&gt;- telefono: String&lt;hr/&gt;+ Persona(id, nombre, correo, tel)&lt;br/&gt;+ getId(): int&lt;br/&gt;+ getNombre(): String&lt;br/&gt;+ setNombre(nombre: String): void&lt;br/&gt;+ getCorreo(): String&lt;br/&gt;+ getTelefono(): String&lt;br/&gt;+ &lt;i&gt;getTipoPersona(): String&lt;/i&gt;" vertex="1">
