        <mxCell id="strat_cinemax" parent="pkg_strategy" style="swimlane;collapsible=0;fontStyle=0;align=left;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;html=1;" value="&lt;b&gt;DescuentoCineMaxRegla&lt;/b&gt;&lt;hr/&gt;&lt;i&gt;Regla Oficial Cesde-Logica&lt;/i&gt;&lt;br/&gt;- porcentaje: double (10%)&lt;hr/&gt;+ calcularDescuento(...): double&lt;br/&gt;  • &lt;b&gt;boletos &amp;gt; 4 || edad &amp;lt; 12&lt;/b&gt;&lt;br/&gt;+ getDescripcion(): String" vertex="1">
