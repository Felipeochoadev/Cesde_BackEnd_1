        <mxCell id="rel_reserva_validador" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="pkg_reservas" source="class_reserva" target="class_validador">
