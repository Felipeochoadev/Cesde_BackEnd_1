        <mxCell id="pkg_reservas" value="Paquete: app.domain (Gestión de Reservas, Boletos y Facturación)" style="swimlane;startSize=25;fillColor=#f8fafc;strokeColor=#94a3b8;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1260" y="210" width="1000" height="490" as="geometry" />
        </mxCell>

        <!-- Boleto -->
        <mxCell id="class_boleto" value="&lt;b&gt;Boleto&lt;/b&gt;&lt;hr/&gt;- id: int&lt;br/&gt;- codigoBoleto: String&lt;br/&gt;- funcion: Funcion&lt;br/&gt;- puesto: Puesto&lt;br/&gt;- precio: double&lt;hr/&gt;+ Boleto(id, codigo, func, puesto)&lt;br/&gt;+ calcularTotal(): double &lt;i&gt;[ICalculable]&lt;/i&gt;&lt;br/&gt;+ getPrecio(): double" style="swimlane;fontStyle=0;align=left;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="pkg_reservas">
          <mxGeometry x="30" y="40" width="240" height="170" as="geometry" />
        </mxCell>

        <!-- Reserva -->
        <mxCell id="class_reserva" value="&lt;b&gt;Reserva&lt;/b&gt;&lt;hr/&gt;- id: int&lt;br/&gt;- cliente: Cliente&lt;br/&gt;- funcion: Funcion&lt;br/&gt;- boletos: List&amp;lt;Boleto&amp;gt;&lt;br/&gt;- cantidadBoletos: int&lt;br/&gt;- fechaReserva: LocalDateTime&lt;br/&gt;- estado: EstadoReserva&lt;br/&gt;&lt;b&gt;- descuentoStrategy: IDescuentoStrategy [DIP]&lt;/b&gt;&lt;br/&gt;&lt;b&gt;- validador: IValidador&amp;lt;Reserva&amp;gt; [DIP]&lt;/b&gt;&lt;hr/&gt;+ Reserva(id, cliente, funcion, cant)&lt;br/&gt;+ agregarBoleto(b: Boleto): void&lt;br/&gt;+ getSubtotal(): double&lt;br/&gt;+ getMontoDescuento(): double&lt;br/&gt;+ calcularTotal(): double &lt;i&gt;[ICalculable]&lt;/i&gt;&lt;br/&gt;+ validarReserva(): void &lt;i&gt;[SRP]&lt;/i&gt;&lt;br/&gt;+ confirmar(): void / cancelar(): void" style="swimlane;fontStyle=0;align=left;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="pkg_reservas">
          <mxGeometry x="300" y="40" width="310" height="270" as="geometry" />
        </mxCell>

        <!-- ValidadorReserva -->
        <mxCell id="class_validador" value="&lt;b&gt;ValidadorReserva&lt;/b&gt;&lt;hr/&gt;&lt;i&gt;&amp;lt;&amp;lt;SRP / Business Rules&amp;gt;&amp;gt;&lt;/i&gt;&lt;hr/&gt;+ validar(reserva: Reserva): void&lt;br/&gt;  • Valida campos obligatorios&lt;br/&gt;  • Valida boletos &amp;gt; 0&lt;br/&gt;  • Valida edad &amp;gt;= 18 si película +18" style="swimlane;fontStyle=0;align=left;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;html=1;" vertex="1" parent="pkg_reservas">
          <mxGeometry x="640" y="40" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- Factura -->
        <mxCell id="class_factura" value="&lt;b&gt;Factura&lt;/b&gt;&lt;hr/&gt;- id: int&lt;br/&gt;- numeroFactura: String&lt;br/&gt;- reserva: Reserva&lt;br/&gt;&lt;b&gt;- metodoPago: MetodoPago [DIP / LSP]&lt;/b&gt;&lt;br/&gt;- fechaEmision: LocalDateTime&lt;br/&gt;- subtotal: double&lt;br/&gt;- descuento: double&lt;br/&gt;- total: double&lt;br/&gt;- pagada: boolean&lt;hr/&gt;+ Factura(id, num, reserva, metodo)&lt;br/&gt;+ procesarPago(): boolean&lt;br/&gt;+ calcularTotal(): double &lt;i&gt;[ICalculable]&lt;/i&gt;&lt;br/&gt;+ generarComprobanteTexto(): String" style="swimlane;fontStyle=0;align=left;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="pkg_reservas">
          <mxGeometry x="640" y="210" width="310" height="230" as="geometry" />
        </mxCell>

        <!-- Relaciones dentro del paquete reservas -->
        <mxCell id="rel_reserva_boleto" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=diamond;endFill=1;" edge="1" parent="pkg_reservas" source="class_reserva" target="class_boleto">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel_factura_reserva" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=diamond;endFill=0;" edge="1" parent="pkg_reservas" source="class_factura" target="class_reserva">
