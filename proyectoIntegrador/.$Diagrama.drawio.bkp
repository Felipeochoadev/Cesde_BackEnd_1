        <!-- ========================================== -->
        <!-- PAQUETE 4: PATRÓN STRATEGY DESCUENTOS (OCP)-->
        <!-- ========================================== -->
        <mxCell id="pkg_strategy" value="Paquete: app.domain.strategy (Patrón Strategy - Principio Abierto/Cerrado OCP)" style="swimlane;startSize=25;fillColor=#f8fafc;strokeColor=#94a3b8;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="1190" height="420" as="geometry" />
        </mxCell>

        <!-- Interfaz IDescuentoStrategy -->
        <mxCell id="iface_descuento" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br/&gt;IDescuentoStrategy&lt;/b&gt;&lt;hr/&gt;+ calcularDescuento(subtotal: double, cant: int, c: Cliente): double&lt;br/&gt;+ getDescripcion(): String" style="swimlane;fontStyle=0;align=left;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;fillColor=#e1d5e7;strokeColor=#9673a6;html=1;" vertex="1" parent="pkg_strategy">
          <mxGeometry x="360" y="45" width="450" height="90" as="geometry" />
        </mxCell>

        <!-- Estrategia 1: Regla CineMax CESDE (Cesde-Logica) -->
