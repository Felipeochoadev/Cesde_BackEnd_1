<mxfile host="Electron" version="24.0.0">
  <diagram id="diagrama-poo-solid-cinemax" name="Diagrama Clases POO y SOLID - CineMax CESDE">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ========================================== -->
        <!-- TITULO Y ENCABEZADO DEL DIAGRAMA           -->
        <!-- ========================================== -->
        <mxCell id="title_banner" value="CINEMAX CESDE - DIAGRAMA DE CLASES BACKEND POO Y PRINCIPIOS S.O.L.I.D." style="swimlane;startSize=0;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;rounded=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="2220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="title_sub" value="Arquitectura de Dominio Orientada a Objetos | Integración: Base de Datos CineMaxCesde + Interfaz HTML + Matriz de Reglas de Negocio" style="text;html=1;align=center;verticalAlign=middle;fontColor=#94a3b8;fontSize=12;fontStyle=2;" vertex="1" parent="title_banner">
          <mxGeometry x="10" y="32" width="2200" height="20" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- CAJAS EXPLICATIVAS DE PRINCIPIOS SOLID    -->
        <!-- ========================================== -->
        <mxCell id="solid_box_s" value="&lt;b&gt;[S] Single Responsibility Principle (SRP)&lt;/b&gt;&lt;br/&gt;• Entidades (Pelicula, Cliente, Sala) solo gestionan su estado interno.&lt;br/&gt;• Validaciones de negocio delegadas a &lt;i&gt;ValidadorReserva&lt;/i&gt;.&lt;br/&gt;• Lógica de descuentos delegada a estrategias &lt;i&gt;IDescuentoStrategy&lt;/i&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="105" width="410" height="85" as="geometry" />
        </mxCell>

        <mxCell id="solid_box_o" value="&lt;b&gt;[O] Open / Closed Principle (OCP)&lt;/b&gt;&lt;br/&gt;• Abierto a extensión, cerrado a modificación.&lt;br/&gt;• Nuevos descuentos (ej. 2x1, estudiante) se añaden creando clases que implementen &lt;i&gt;IDescuentoStrategy&lt;/i&gt;.&lt;br/&gt;• Nuevos métodos de pago implementan &lt;i&gt;MetodoPago&lt;/i&gt; / &lt;i&gt;IPagable&lt;/i&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;fontColor=#14532d;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="105" width="410" height="85" as="geometry" />
        </mxCell>

        <mxCell id="solid_box_l" value="&lt;b&gt;[L] Liskov Substitution Principle (LSP)&lt;/b&gt;&lt;br/&gt;• Subclases &lt;i&gt;Cliente&lt;/i&gt; y &lt;i&gt;Empleado&lt;/i&gt; pueden sustituir a la clase base &lt;i&gt;Persona&lt;/i&gt;.&lt;br/&gt;• Cualquier método de pago (&lt;i&gt;PagoTarjeta&lt;/i&gt;, &lt;i&gt;PagoEfectivo&lt;/i&gt;, &lt;i&gt;PagoDigital&lt;/i&gt;) es completamente intercambiable en &lt;i&gt;Factura&lt;/i&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#eab308;fontColor=#713f12;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="105" width="410" height="85" as="geometry" />
        </mxCell>

        <mxCell id="solid_box_i" value="&lt;b&gt;[I] Interface Segregation Principle (ISP)&lt;/b&gt;&lt;br/&gt;• Interfaces segregadas y de propósito único:&lt;br/&gt;  - &lt;i&gt;ICalculable&lt;/i&gt;: Para objetos con costo monetario.&lt;br/&gt;  - &lt;i&gt;IValidador&amp;lt;T&amp;gt;&lt;/i&gt;: Para reglas de negocio.&lt;br/&gt;  - &lt;i&gt;IPagable&lt;/i&gt;: Para cobro y detalle de pago.&lt;br/&gt;  - &lt;i&gt;IDescuentoStrategy&lt;/i&gt;: Para descuentos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;fontColor=#581c87;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1360" y="105" width="410" height="85" as="geometry" />
        </mxCell>

        <mxCell id="solid_box_d" value="&lt;b&gt;[D] Dependency Inversion Principle (DIP)&lt;/b&gt;&lt;br/&gt;• Módulos de alto nivel (&lt;i&gt;Reserva&lt;/i&gt;, &lt;i&gt;Factura&lt;/i&gt;) dependen de abstracciones (&lt;i&gt;IDescuentoStrategy&lt;/i&gt;, &lt;i&gt;IValidador&lt;/i&gt;, &lt;i&gt;MetodoPago&lt;/i&gt;), nunca de clases concretas directamente acopladas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#f43f5e;fontColor=#881337;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1800" y="105" width="460" height="85" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
